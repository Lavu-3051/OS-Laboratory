#include <stdio.h>

int p,r,m,z,k,buf;
int a[10],avail[10],max[10][10],alloc[10][10],need[10][10];
int i,j,top;

void get()
{
    printf("\nENTER THE NUMBER OF PROCESSES: ");
    scanf("%d",&p);

    printf("\nENTER THE NUMBER OF RESOURCE TYPES: ");
    scanf("%d",&r);

    for(j=0;j<r;j++)
    {
        printf("ENTER RESOURCES FOR TYPE %d: ",j+1);
        scanf("%d",&avail[j]);
    }

    for(i=0;i<p;i++)
    {
        printf("\nMAX RESOURCES REQUIRED FOR PROCESS %d\n",i+1);
        for(j=0;j<r;j++)
        {
            printf("Resource %d: ",j+1);
            scanf("%d",&max[i][j]);
        }
    }

    printf("\nENTER ALLOCATED INSTANCES\n");

    for(i=0;i<p;i++)
    {
        printf("\nPROCESS %d\n",i+1);

        for(j=0;j<r;j++)
        {
            printf("Resource %d: ",j+1);
            scanf("%d",&m);

            if(m<=avail[j])
            {
                alloc[i][j]=m;
                avail[j]-=m;
            }
            else
            {
                printf("ALLOCATION EXCEEDS AVAILABLE\n");
                j--;
            }
        }
    }
}

void disp1()
{
    printf("\nNEED MATRIX\n");

    for(i=0;i<p;i++)
    {
        printf("P%d: ",i+1);
        for(j=0;j<r;j++)
        {
            need[i][j]=max[i][j]-alloc[i][j];
            printf("%d ",need[i][j]);
        }
        printf("\n");
    }
}

void seqnc()
{
    int finish[10]={0};
    top=0;

    while(top<p)
    {
        for(i=0;i<p;i++)
        {
            if(finish[i]==0)
            {
                buf=0;

                for(j=0;j<r;j++)
                {
                    if(need[i][j] <= avail[j])
                        buf++;
                }

                if(buf==r)
                {
                    a[top]=i;
                    top++;

                    for(k=0;k<r;k++)
                        avail[k]+=alloc[i][k];

                    finish[i]=1;
                }
            }
        }
    }
}

void disp2()
{
    printf("\nSAFE SEQUENCE:\n");

    for(i=0;i<p;i++)
        printf("P%d ",a[i]+1);

    printf("\n");
}

int main()
{
    get();
    disp1();
    seqnc();
    disp2();
    return 0;
}
